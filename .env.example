# LLM (one of the two; OpenAI wins when both set)
OPENAI_API_KEY=REPLACE_ME      # sk-proj-...  any value starting with REPLACE counts as unset
ANTHROPIC_API_KEY=REPLACE_ME   # sk-ant-...
LLM_PROVIDER=                  # openai | anthropic; auto from keys when blank
AGENT_MODEL=                   # default gpt-5.4-mini (openai) / claude-sonnet-5-5 (anthropic)
PLANNER_MODEL=                 # default gpt-5.5 (openai) / claude-opus-5-5 (anthropic)

FIRECRAWL_API_KEY=REPLACE_ME   # fc-...  live part prices/stock
CONVEX_URL=REPLACE_ME          # https://<deployment>.convex.cloud (optional, live agent lanes)
CONVEX_DEPLOY_KEY=REPLACE_ME   # optional

PHOTON_API_KEY=REPLACE_ME      # pho_sk_... project API key (secret: Photon dashboard -> project -> API keys)
PHOTON_PROJECT_ID=pho_prj_01m67r8gkvfap8x9vtc1fxabze   # "Founders Inc hackathon" project
PHOTON_AGENT_HANDLE=           # optional; shared lines: +16283166196, +16282634622 (only needed for dedicated lines)

HEYPCB_API_KEY=REPLACE_ME      # hpcb_pk_... (secret: heypcb.ai -> Settings -> Devices & API keys)
HEYPCB_BUILD=0                 # 1 = design a real HeyPCB board per run (minutes; bills the account)
HEYPCB_CONTINUES=3             # billed 'continue' turns when Inky pauses before the board is done
HEYPCB_TIMEOUT_S=1800

PUBLIC_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
MUJOCO_GL=egl                  # linux; macOS auto-switches to cgl
PYOPENGL_PLATFORM=osmesa       # linux headless GIF rendering
DEMO_SCRIPTED_FAIL=1
MAX_ITERATIONS=3
LLM_TIMEOUT_S=40
FIRECRAWL_TIMEOUT_S=20
SIM_SEED=7
