ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
CONVEX_URL=
CONVEX_DEPLOY_KEY=
PHOTON_API_KEY=          # pho_sk_... project API key
PHOTON_PROJECT_ID=       # pho_prj_...
PHOTON_AGENT_HANDLE=     # optional, agent line number in E.164
HEYPCB_API_KEY=          # hpcb_pk_... from heypcb.ai -> Settings -> Devices & API keys
HEYPCB_BUILD=0           # 1 = design a real HeyPCB board per run (minutes; bills the account)
HEYPCB_CONTINUES=3       # billed 'continue' turns when Inky pauses before the board is done
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
MUJOCO_GL=egl            # linux; macOS auto-switches to cgl
DEMO_SCRIPTED_FAIL=1
AGENT_MODEL=claude-sonnet-5-5
PLANNER_MODEL=claude-opus-5-5
