{% extends "mecanum_base.xml.j2" %}
{% block arm %}
          <body name="arm_base" pos="{{ L*0.3 }} 0 {{ H }}">
            <joint name="arm_q1" type="hinge" axis="0 0 1" range="-3 3"/>
            <geom type="cylinder" size="0.015 0.01" mass="{{ servo_mass }}" rgba="0.8 0.8 0.8 1"/>
            <body name="arm_link1" pos="0 0 0.01">
              <joint name="arm_q2" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
              <geom type="capsule" fromto="0 0 0 {{ reach*0.5 }} 0 0" size="0.008" mass="{{ servo_mass }}" rgba="0.8 0.8 0.8 1"/>
              <body name="arm_link2" pos="{{ reach*0.5 }} 0 0">
                <joint name="arm_q3" type="hinge" axis="0 1 0" range="-2 2"/>
                <geom type="capsule" fromto="0 0 0 {{ reach*0.5 }} 0 0" size="0.007" mass="{{ servo_mass }}" rgba="0.8 0.8 0.8 1"/>
                <body name="gripper" pos="{{ reach*0.5 }} 0 0">
                  <site name="gripper_site" pos="0.02 0 0"/>
                  <geom name="gripper_geom" type="box" size="0.02 0.025 0.01" mass="{{ gripper_mass }}" rgba="0.9 0.9 0.2 1"/>
                </body>
              </body>
            </body>
          </body>
{% endblock %}
{% block arm_actuators %}
    <position name="a1" joint="arm_q1" kp="{{ servo_kp }}" ctrlrange="-3 3"/>
    <position name="a2" joint="arm_q2" kp="{{ servo_kp }}" ctrlrange="-1.6 1.6"/>
    <position name="a3" joint="arm_q3" kp="{{ servo_kp }}" ctrlrange="-2 2"/>
{% endblock %}
