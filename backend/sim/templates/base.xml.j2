<mujoco model="roboforge_{{ template }}">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.9 0.93 1" rgb2="0.6 0.7 0.9" width="32" height="32"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.7 0.7 0.7" width="256" height="256"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="chassis_mat" rgba="0.2 0.5 0.9 1"/>
    <material name="wheel_mat" rgba="0.1 0.1 0.1 1"/>
    <material name="target_mat" rgba="0.9 0.1 0.1 1"/>
    <material name="obstacle_mat" rgba="0.5 0.35 0.2 1"/>
  </asset>
  <default>
    <geom condim="3" friction="1.0 0.005 0.0001" solref="0.01 1"/>
    <joint damping="0.0005"/>
  </default>
  <worldbody>
    <light pos="1 1 3" dir="-0.3 -0.3 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>
    {% include scene_file %}
    {% block robot %}{% endblock %}
  </worldbody>
  {% block actuators %}{% endblock %}
  <sensor>
    <framepos name="chassis_pos" objtype="body" objname="chassis"/>
    <framequat name="chassis_quat" objtype="body" objname="chassis"/>
    <velocimeter name="chassis_vel" site="imu_site"/>
    <gyro name="chassis_gyro" site="imu_site"/>
  </sensor>
</mujoco>
